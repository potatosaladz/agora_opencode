# Copy this file to .env and fill every value before starting the development stack.
# These local-only credentials must never be reused outside a developer machine.
POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Bounded Z3 execution; accepted range is 1..60000 milliseconds.
SYMBOLIC_TIMEOUT_MS=5000
