# Copy this file to .env and fill every value before starting the development stack.
# These local-only credentials must never be reused outside a developer machine.
POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MCP_WORKLOAD_SECRET=

# Bounded Z3 execution; accepted range is 1..60000 milliseconds.
SYMBOLIC_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Host ports published by the development stack (bind to 127.0.0.1 only).
# This repository runs its Compose stack under the project name `agora_opencode`
# so its generated volumes/networks can never collide with the original `agora`
# development stack. The host ports below default to the 1xxxx range for the same
# reason: both stacks can run side-by-side on one machine without touching the
# other's published ports. Container-internal ports and service hostnames are
# unchanged. Override any variable to move that service to another host port.
# ---------------------------------------------------------------------------
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
NATS_HOST_PORT=14222
NATS_MONITOR_HOST_PORT=18222
TEMPORAL_POSTGRES_HOST_PORT=15433
TEMPORAL_HOST_PORT=17233
TEMPORAL_UI_HOST_PORT=18080
BACKEND_HOST_PORT=18000
FRONTEND_HOST_PORT=13000